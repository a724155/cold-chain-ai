<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ymm.coldchainai.agent.audit.infrastructure.persistence.mapper.IToolExecutionMapper">

    <!-- Tool执行审计查询结果映射。 -->
    <resultMap id="ToolExecutionResultMap" type="com.ymm.coldchainai.agent.audit.infrastructure.persistence.dataobject.ToolExecutionDO">

        <id property="id" column="id"/>

        <result property="toolExecutionId" column="tool_execution_id"/>
        <result property="requestId" column="request_id"/>
        <result property="agentCode" column="agent_code"/>
        <result property="toolName" column="tool_name"/>
        <result property="currentUserId" column="current_user_id"/>
        <result property="currentTenantId" column="current_tenant_id"/>
        <result property="inputSummary" column="input_summary"/>
        <result property="outputSummary" column="output_summary"/>
        <result property="executionStatus" column="execution_status"/>
        <result property="errorCode" column="error_code"/>
        <result property="errorMessage" column="error_message"/>
        <result property="startTime" column="start_time"/>
        <result property="finishTime" column="finish_time"/>
        <result property="costMillis" column="cost_millis"/>

    </resultMap>

    <!-- Tool执行审计查询统一字段列表。 -->
    <sql id="BaseColumnList">
        id,
        tool_execution_id,
        request_id,
        agent_code,
        tool_name,
        current_user_id,
        current_tenant_id,
        input_summary,
        output_summary,
        execution_status,
        error_code,
        error_message,
        start_time,
        finish_time,
        cost_millis
    </sql>

    <!--
        插入一条RUNNING状态的Tool执行审计记录。

        正式执行顺序是：
        1. 先插入RUNNING审计记录；
        2. 提交本次审计写入事务；
        3. 再执行真实Tool业务；
        4. Tool完成后通过另一条UPDATE写入SUCCEEDED或者FAILED。

        不能把真实Tool执行包在本次INSERT事务中。
        订单查询、支付查询、RAG向量检索或者未来RPC耗时不可控，
        长事务会持续占用数据库连接和事务资源。
    -->
    <insert id="insertRunning"
            parameterType="com.ymm.coldchainai.agent.audit.infrastructure.persistence.dataobject.ToolExecutionDO"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO cold_chain_ai_tool_execution
        (
        tool_execution_id,
        request_id,
        agent_code,
        tool_name,
        current_user_id,
        current_tenant_id,
        input_summary,
        execution_status,
        start_time
        )
        VALUES
        (
        #{toolExecutionId},
        #{requestId},
        #{agentCode},
        #{toolName},
        #{currentUserId},
        #{currentTenantId},
        #{inputSummary},
        #{executionStatus},
        #{startTime}
        )

    </insert>

    <!--
        将Tool执行状态从RUNNING原子更新为SUCCEEDED。

        这里不需要先SELECT ... FOR UPDATE：
        当前操作不需要读取数据库字段后再计算新业务结果，
        而是直接通过一条带状态条件的UPDATE完成状态推进。

        WHERE execution_status = #{expectedStatus}
        相当于轻量级乐观状态校验：

        - 更新1行：说明记录存在并且仍然处于RUNNING；
        - 更新0行：说明记录不存在、已经完成或者发生了重复更新；
        - Repository必须把更新0行视为异常，不能假装成功。

        与订单FOR UPDATE对比：
        订单往往需要先读取金额、状态或库存，再根据读取结果做复杂判断和写入，
        因此需要悲观锁保护完整读后写链路。

        Tool审计终态更新只需要执行确定性的状态推进，
        使用单条条件UPDATE即可避免不必要的行锁查询。
    -->
    <update id="updateToSucceeded" parameterType="com.ymm.coldchainai.agent.audit.infrastructure.persistence.dataobject.ToolExecutionDO">

        UPDATE cold_chain_ai_tool_execution
        SET execution_status = #{executionStatus},
        output_summary = #{outputSummary},
        error_code = NULL,
        error_message = NULL,
        finish_time = #{finishTime},
        cost_millis = #{costMillis},
        update_time = CURRENT_TIMESTAMP(3)
        WHERE tool_execution_id = #{toolExecutionId}
        AND execution_status = #{expectedStatus}

    </update>

    <!--
        将Tool执行状态从RUNNING原子更新为FAILED。
        FAILED和SUCCEEDED都属于不可再次变更的终态，因此SQL同样要求数据库原状态必须是RUNNING。
        如果同一Tool异常处理代码被重复执行，第一次UPDATE会成功，第二次UPDATE影响0行，
        Repository会明确暴露重复状态推进问题。
    -->
    <update id="updateToFailed"
            parameterType="com.ymm.coldchainai.agent.audit.infrastructure.persistence.dataobject.ToolExecutionDO">

        UPDATE cold_chain_ai_tool_execution
        SET execution_status = #{executionStatus},
        output_summary = NULL,
        error_code = #{errorCode},
        error_message = #{errorMessage},
        finish_time = #{finishTime},
        cost_millis = #{costMillis},
        update_time = CURRENT_TIMESTAMP(3)
        WHERE tool_execution_id = #{toolExecutionId}
        AND execution_status = #{expectedStatus}

    </update>

    <!--
        根据requestId查询当前用户和租户拥有的Tool审计记录。
        这里同时使用：
        request_id
        current_user_id
        current_tenant_id
        即使调用者猜到其他用户的requestId，也无法读取对应Tool调用记录。
        查询只读取审计数据，不执行状态修改，因此不使用FOR UPDATE。
        ORDER BY id ASC表示按照RUNNING审计记录实际插入顺序返回，便于观察本轮Agent先后调用了哪些Tool。
    -->
    <select id="selectByRequestIdAndOwner" resultMap="ToolExecutionResultMap">

        SELECT
        <include refid="BaseColumnList"/>
        FROM cold_chain_ai_tool_execution
        WHERE request_id = #{requestId}
        AND current_user_id = #{currentUserId}
        AND current_tenant_id = #{currentTenantId}
        ORDER BY id ASC

    </select>

</mapper>